# Fichiers jamais publiés sur le site (Cloudflare) : outillage, CI, code serveur.
# Même rôle que .vercelignore, en plus strict.
.git
.github
.claude
.wrangler
.dev.vars*
node_modules
scripts
api
worker
openspec
wrangler.jsonc
vercel.json
.vercelignore
.gitignore
.gitleaks.toml

